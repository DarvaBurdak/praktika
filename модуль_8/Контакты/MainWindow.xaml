<Window x:Class="ContactsWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление контактами"
        Height="650"
        Width="1000"
        MinHeight="520"
        MinWidth="760"
        WindowStartupLocation="CenterScreen"
        Background="#F5F1F8">

    <!--
        Ресурсы окна содержат общие цвета и стили.
        Благодаря этому не нужно отдельно настраивать каждую кнопку и поле.
    -->
    <Window.Resources>

        <!-- Палитра, подобранная по предоставленному изображению. -->
        <SolidColorBrush x:Key="DarkPurple" Color="#28104E"/>
        <SolidColorBrush x:Key="MainPurple" Color="#6237A0"/>
        <SolidColorBrush x:Key="AccentPurple" Color="#9754CB"/>
        <SolidColorBrush x:Key="LightPurple" Color="#DEACF5"/>
        <SolidColorBrush x:Key="WindowBackground" Color="#F5F1F8"/>
        <SolidColorBrush x:Key="BorderPurple" Color="#D9C6E8"/>

        <!-- Общий стиль кнопок. -->
        <Style TargetType="{x:Type Button}">
            <!-- Основной цвет кнопки и цвет её текста. -->
            <Setter Property="Background" Value="{StaticResource MainPurple}"/>
            <Setter Property="Foreground" Value="White"/>

            <!-- Убираем стандартную рамку. -->
            <Setter Property="BorderThickness" Value="0"/>

            <!-- Настраиваем текст и внутренние отступы. -->
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Margin" Value="0,0,10,8"/>

            <!-- Указываем, что кнопка предназначена для нажатия. -->
            <Setter Property="Cursor" Value="Hand"/>

            <!-- Создаём собственный шаблон внешнего вида кнопки. -->
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <!-- Закруглённый фон кнопки. -->
                        <Border x:Name="ButtonBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8"
                                Padding="{TemplateBinding Padding}">

                            <!-- Здесь отображается текст кнопки. -->
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"/>
                        </Border>

                        <!-- Изменяем внешний вид в зависимости от состояния. -->
                        <ControlTemplate.Triggers>

                            <!-- При наведении курсора кнопка становится ярче. -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Background"
                                        Value="{StaticResource AccentPurple}"/>
                            </Trigger>

                            <!-- Отключённая кнопка становится полупрозрачной. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                            <!-- При нажатии кнопка немного темнеет. -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="ButtonBorder"
                                        Property="Opacity"
                                        Value="0.8"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Общий стиль полей ввода. -->
        <Style TargetType="{x:Type TextBox}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPurple}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="9,6"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="0,4"/>
        </Style>

        <!-- Общий стиль подписей и текстовых надписей. -->
        <Style TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

        <!-- Общий стиль таблицы контактов. -->
        <Style TargetType="{x:Type DataGrid}">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderPurple}"/>
            <Setter Property="BorderThickness" Value="1"/>

            <!-- Чередуем фон строк для удобства чтения. -->
            <Setter Property="RowBackground" Value="White"/>
            <Setter Property="AlternatingRowBackground" Value="#F7F1FC"/>
            <Setter Property="AlternationCount" Value="2"/>

            <!-- Оставляем горизонтальные линии между строками. -->
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E8DDF1"/>

            <!-- Разрешаем изменять ширину столбцов. -->
            <Setter Property="CanUserResizeColumns" Value="True"/>
        </Style>

        <!-- Стиль заголовков столбцов таблицы. -->
        <Style TargetType="{x:Type DataGridColumnHeader}">
            <Setter Property="Background" Value="{StaticResource DarkPurple}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>

        <!-- Стиль подписей над полями ввода. -->
        <Style x:Key="FieldLabelStyle" TargetType="{x:Type TextBlock}">
            <Setter Property="Foreground" Value="{StaticResource DarkPurple}"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>

    </Window.Resources>

    <!--
        Главная сетка окна.
        Строки с Auto занимают необходимую высоту,
        а строка со звёздочкой получает всё оставшееся пространство.
        Поэтому таблица растёт и уменьшается вместе с окном.
    -->
    <Grid Margin="24">

        <Grid.RowDefinitions>
            <!-- Заголовок приложения. -->
            <RowDefinition Height="Auto"/>

            <!-- Поле поиска. -->
            <RowDefinition Height="Auto"/>

            <!-- Поля данных контакта. -->
            <RowDefinition Height="Auto"/>

            <!-- Кнопки управления. -->
            <RowDefinition Height="Auto"/>

            <!-- Таблица контактов занимает свободное место. -->
            <RowDefinition Height="*"/>

            <!-- Строка сообщений. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок и поясняющая надпись. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,22">
            <TextBlock Text="Управление контактами"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#28104E"/>

            <TextBlock Text="Ваша контактная книга"
                       FontSize="14"
                       Foreground="#9754CB"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Карточка поиска с белым фоном и закруглёнными углами. -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D9C6E8"
                BorderThickness="1"
                Padding="14"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Колонка подписи занимает нужную ширину. -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- Поле поиска растягивается на свободное место. -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="Поиск по имени"
                           FontWeight="SemiBold"
                           Margin="0,0,14,0"/>

                <!-- При изменении текста вызывается обработчик поиска. -->
                <TextBox x:Name="txtSearch"
                         Grid.Column="1"
                         Margin="0"
                         Height="38"
                         ToolTip="Введите имя или часть имени"
                         TextChanged="txtSearch_TextChanged"/>
            </Grid>
        </Border>

        <!-- Карточка с полями для ввода данных контакта. -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D9C6E8"
                BorderThickness="1"
                Padding="16"
                Margin="0,0,0,16">

            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Подпись имени. -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- Поле имени. -->
                    <ColumnDefinition Width="*"/>

                    <!-- Подпись телефона. -->
                    <ColumnDefinition Width="Auto"/>

                    <!-- Поле телефона. -->
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <!-- Первая строка: имя и телефон. -->
                    <RowDefinition Height="Auto"/>

                    <!-- Вторая строка: почта и идентификатор. -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Grid.Column="0"
                           Text="Имя:"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"/>

                <TextBox x:Name="txtName"
                         Grid.Row="0"
                         Grid.Column="1"
                         Height="36"
                         Margin="0,0,18,8"
                         ToolTip="Введите имя и фамилию"/>

                <TextBlock Grid.Row="0"
                           Grid.Column="2"
                           Text="Телефон:"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,8"/>

                <TextBox x:Name="txtPhone"
                         Grid.Row="0"
                         Grid.Column="3"
                         Height="36"
                         Margin="0,0,0,8"
                         ToolTip="Введите номер телефона"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="0"
                           Text="Эл. почта:"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,0"/>

                <TextBox x:Name="txtEmail"
                         Grid.Row="1"
                         Grid.Column="1"
                         Height="36"
                         Margin="0,0,18,0"
                         ToolTip="Введите адрес электронной почты"/>

                <TextBlock Grid.Row="1"
                           Grid.Column="2"
                           Text="ID:"
                           Style="{StaticResource FieldLabelStyle}"
                           Margin="0,0,12,0"/>

                <!-- ID присваивается автоматически, поэтому поле только для чтения. -->
                <TextBox x:Name="txtId"
                         Grid.Row="1"
                         Grid.Column="3"
                         Height="36"
                         Margin="0"
                         IsReadOnly="True"
                         Background="#F5F1F8"
                         ToolTip="Идентификатор выбранного контакта"/>
            </Grid>
        </Border>

        <!-- Панель кнопок основных действий. -->
        <WrapPanel Grid.Row="3" Margin="0,0,0,12">

            <!-- Добавление нового контакта. -->
            <Button Content="Добавить контакт"
                    Click="btnAdd_Click"/>

            <!-- Изменение данных выбранного контакта. -->
            <Button Content="Редактировать"
                    Click="btnUpdate_Click"/>

            <!-- Удаление выбранного контакта. -->
            <Button Content="Удалить"
                    Click="btnDelete_Click"/>

            <!-- Очистка полей ввода. -->
            <Button Content="Очистить поля"
                    Background="#9754CB"
                    Click="btnClear_Click"/>
        </WrapPanel>

        <!-- Внешняя карточка таблицы. -->
        <Border Grid.Row="4"
                Background="White"
                CornerRadius="12"
                BorderBrush="#D9C6E8"
                BorderThickness="1"
                Padding="8"
                Margin="0,0,0,12">

            <!-- Таблица автоматически занимает доступное пространство. -->
            <DataGrid x:Name="ContactsGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      SelectionChanged="ContactsGrid_SelectionChanged">

                <!-- Определяем столбцы вручную, чтобы управлять их видом. -->
                <DataGrid.Columns>

                    <!-- ID контакта. -->
                    <DataGridTextColumn Header="ID"
                                        Binding="{Binding Id}"
                                        Width="65"/>

                    <!-- Имя человека. -->
                    <DataGridTextColumn Header="Имя"
                                        Binding="{Binding Name}"
                                        Width="*"/>

                    <!-- Телефон. -->
                    <DataGridTextColumn Header="Телефон"
                                        Binding="{Binding Phone}"
                                        Width="*"/>

                    <!-- Электронная почта. -->
                    <DataGridTextColumn Header="Электронная почта"
                                        Binding="{Binding Email}"
                                        Width="1.5*"/>

                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Сообщение о результате последнего действия. -->
        <TextBlock x:Name="txtMessage"
                   Grid.Row="5"
                   Text="Готово к работе."
                   Foreground="#6237A0"
                   FontWeight="SemiBold"
                   Margin="2,0,0,0"/>
    </Grid>
</Window>

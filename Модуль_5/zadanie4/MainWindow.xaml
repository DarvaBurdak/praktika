<Window x:Class="ImageViewerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Просмотр изображений"
        Height="650"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <!-- Главная сетка окна -->
    <Grid Background="#FFF2F2F2">

        <Grid.RowDefinitions>
            <!-- Главное меню -->
            <RowDefinition Height="Auto"/>

            <!-- Панель инструментов -->
            <RowDefinition Height="Auto"/>

            <!-- Область просмотра занимает всё свободное место -->
            <RowDefinition Height="*"/>

            <!-- Строка информации внизу -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Главное меню программы -->
        <Menu Grid.Row="0">
            <MenuItem Header="Файл">
                <MenuItem Header="Открыть изображение..."
                          Click="OpenImage_Click"/>
                <Separator/>
                <MenuItem Header="Выход"
                          Click="Exit_Click"/>
            </MenuItem>

            <MenuItem Header="Масштаб">
                <MenuItem Header="Приблизить"
                          Click="ZoomIn_Click"/>
                <MenuItem Header="Отдалить"
                          Click="ZoomOut_Click"/>
                <MenuItem Header="Исходный размер (100%)"
                          Click="ActualSize_Click"/>
                <MenuItem Header="По размеру окна"
                          Click="FitToWindow_Click"/>
            </MenuItem>
        </Menu>

        <!-- Панель кнопок масштабирования -->
        <ToolBar Grid.Row="1" Padding="5">

            <Button Content="Открыть"
                    Padding="12,6"
                    Margin="2"
                    Click="OpenImage_Click"
                    ToolTip="Открыть изображение с компьютера"/>

            <Separator/>

            <!-- Увеличивает масштаб изображения -->
            <Button Content="＋ Приблизить"
                    Padding="12,6"
                    Margin="2"
                    Click="ZoomIn_Click"
                    ToolTip="Увеличить изображение"/>

            <!-- Уменьшает масштаб изображения -->
            <Button Content="－ Отдалить"
                    Padding="12,6"
                    Margin="2"
                    Click="ZoomOut_Click"
                    ToolTip="Уменьшить изображение"/>

            <Separator/>

            <!-- Возвращает масштаб 100 процентов -->
            <Button Content="100%"
                    Padding="12,6"
                    Margin="2"
                    Click="ActualSize_Click"
                    ToolTip="Показать изображение в исходном размере"/>

            <!-- Подбирает масштаб под размер области просмотра -->
            <Button Content="По размеру окна"
                    Padding="12,6"
                    Margin="2"
                    Click="FitToWindow_Click"
                    ToolTip="Уместить изображение в области просмотра"/>

            <Separator/>

            <!-- Показывает текущий масштаб -->
            <TextBlock x:Name="txtZoom"
                       Text="Масштаб: 100%"
                       VerticalAlignment="Center"
                       Margin="8,0,8,0"/>
        </ToolBar>

        <!-- Область отображения фотографии -->
        <Border Grid.Row="2"
                Margin="10"
                Background="#FF303030"
                BorderBrush="#FFB0B0B0"
                BorderThickness="1"
                CornerRadius="4">

            <!--
                ScrollViewer позволяет прокручивать изображение,
                если после увеличения оно становится больше окна.

                HorizontalScrollBarVisibility и VerticalScrollBarVisibility
                включают полосы прокрутки при необходимости.
            -->
            <ScrollViewer x:Name="imageScrollViewer"
                          HorizontalScrollBarVisibility="Auto"
                          VerticalScrollBarVisibility="Auto"
                          CanContentScroll="False">

                <!--
                    Контейнер изображения.
                    Он позволяет размещать большое изображение
                    внутри прокручиваемой области.
                -->
                <Grid>

                    <!--
                        Image отображает выбранную фотографию.

                        Stretch="None" означает, что изображение
                        использует свой исходный размер в пикселях.

                        Масштаб будет изменяться с помощью LayoutTransform
                        в коде C#.
                    -->
                    <Image x:Name="imgPreview"
                           Stretch="None"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center">

                        <!--
                            ScaleTransform изменяет ширину и высоту
                            изображения относительно исходного размера.

                            ScaleX и ScaleY будут меняться одновременно,
                            чтобы не нарушать пропорции фотографии.
                        -->
                        <Image.LayoutTransform>
                            <ScaleTransform x:Name="imageScale"
                                            ScaleX="1"
                                            ScaleY="1"/>
                        </Image.LayoutTransform>

                    </Image>
                </Grid>
            </ScrollViewer>
        </Border>

        <!-- Информация о фотографии -->
        <StatusBar Grid.Row="3">

            <!-- Имя открытого файла -->
            <TextBlock x:Name="txtFileInfo"
                       Text="Изображение не выбрано"/>

            <Separator/>

            <!-- Исходные размеры фотографии -->
            <TextBlock x:Name="txtImageSize"
                       Text="Размер: —"/>

        </StatusBar>

    </Grid>
</Window>

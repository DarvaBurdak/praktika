<Window x:Class="DrawingAppWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Графический редактор"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <!-- Основная сетка окна: инструменты слева, холст справа. -->
    <Grid Background="#F0F0F0">
        <Grid.ColumnDefinitions>
            <!-- Левая колонка для кнопок инструментов. -->
            <ColumnDefinition Width="160"/>

            <!-- Правая колонка занимает всё оставшееся место. -->
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Панель инструментов. -->
        <StackPanel Grid.Column="0"
                    Background="#E0E0E0"
                    Margin="10"
                    VerticalAlignment="Top">

            <!-- Заголовок панели. -->
            <TextBlock Text="Инструменты"
                       FontSize="18"
                       FontWeight="Bold"
                       Margin="5,10,5,15"
                       HorizontalAlignment="Center"/>

            <!-- Кнопка выбора инструмента рисования линий. -->
            <Button x:Name="btnLine"
                    Content="Линия"
                    Height="40"
                    Margin="5"
                    Click="btnLine_Click"/>

            <!-- Кнопка выбора инструмента рисования кругов. -->
            <Button x:Name="btnCircle"
                    Content="Круг"
                    Height="40"
                    Margin="5"
                    Click="btnCircle_Click"/>

            <!-- Кнопка выбора инструмента рисования квадратов. -->
            <Button x:Name="btnSquare"
                    Content="Квадрат"
                    Height="40"
                    Margin="5"
                    Click="btnSquare_Click"/>

            <!-- Кнопка удаления всех нарисованных фигур. -->
            <Button x:Name="btnClear"
                    Content="Очистить"
                    Height="40"
                    Margin="5,20,5,5"
                    Click="btnClear_Click"/>

            <!-- Подсказка для пользователя. -->
            <TextBlock Text="Зажмите левую кнопку мыши и перемещайте курсор по холсту."
                       TextWrapping="Wrap"
                       Margin="8,15,8,5"
                       FontSize="12"/>
        </StackPanel>

        <!-- Рамка вокруг области рисования. -->
        <Border Grid.Column="1"
                BorderBrush="Gray"
                BorderThickness="1"
                Background="White"
                Margin="0,10,10,10">

            <!-- Холст, на котором будут появляться фигуры. -->
            <Canvas x:Name="canvasDrawing"
                    Background="White"
                    ClipToBounds="True"
                    MouseLeftButtonDown="canvasDrawing_MouseLeftButtonDown"
                    MouseMove="canvasDrawing_MouseMove"
                    MouseLeftButtonUp="canvasDrawing_MouseLeftButtonUp"/>
        </Border>
    </Grid>
</Window>
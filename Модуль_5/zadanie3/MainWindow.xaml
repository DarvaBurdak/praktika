<Window x:Class="TaskManagerWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Менеджер задач"
        Height="500"
        Width="750"
        MinHeight="400"
        MinWidth="550"
        WindowStartupLocation="CenterScreen">

    <!-- Главная сетка окна -->
    <Grid Margin="15">

        <!-- Создаём три строки:
             заголовок, добавление задачи и список с кнопками -->
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок программы -->
        <TextBlock Grid.Row="0"
                   Text="Менеджер задач"
                   FontSize="26"
                   FontWeight="Bold"
                   Margin="0,0,0,15"/>

        <!-- Панель добавления новой задачи -->
        <Grid Grid.Row="1" Margin="0,0,0,15">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <!-- Поле для ввода текста задачи -->
            <TextBox x:Name="txtTask"
                     Grid.Column="0"
                     Height="35"
                     FontSize="15"
                     VerticalContentAlignment="Center"
                     Padding="8"
                     Margin="0,0,10,0"
                     ToolTip="Введите новую задачу"/>

            <!-- Кнопка добавления задачи -->
            <Button Grid.Column="1"
                    Content="Добавить"
                    Width="110"
                    Height="35"
                    FontSize="14"
                    Click="AddTask_Click"/>
        </Grid>

        <!-- Нижняя область: список задач и кнопки управления -->
        <Grid Grid.Row="2">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="170"/>
            </Grid.ColumnDefinitions>

            <!-- Список задач -->
            <ListBox x:Name="lstTasks"
                     Grid.Column="0"
                     FontSize="15"
                     Padding="5"
                     Margin="0,0,15,0"
                     ItemsSource="{Binding Tasks}"
                     SelectedItem="{Binding SelectedTask, Mode=TwoWay}">

                <!-- Задаём внешний вид каждой задачи -->
                <ListBox.ItemTemplate>
                    <DataTemplate>

                        <CheckBox Content="{Binding TaskText}"
                                  IsChecked="{Binding IsCompleted, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                  FontSize="15"
                                  Padding="5"
                                  Margin="3"/>

                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Панель кнопок справа -->
            <StackPanel Grid.Column="1">

                <!-- Удаление выбранной задачи -->
                <Button Content="Удалить выбранную"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="DeleteTask_Click"/>

                <!-- Удаление всех выполненных задач -->
                <Button Content="Удалить выполненные"
                        Height="40"
                        Margin="0,0,0,10"
                        Click="DeleteCompleted_Click"/>

                <!-- Полная очистка списка -->
                <Button Content="Очистить список"
                        Height="40"
                        Margin="0,0,0,20"
                        Click="ClearTasks_Click"/>

                <!-- Показываем количество задач -->
                <TextBlock x:Name="txtStatistics"
                           FontSize="14"
                           TextWrapping="Wrap"
                           Text="Всего задач: 0"
                           Margin="0,0,0,10"/>

            </StackPanel>
        </Grid>
    </Grid>
</Window>

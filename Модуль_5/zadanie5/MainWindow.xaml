<Window x:Class="CalculatorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Калькулятор"
        Height="550"
        Width="370"
        MinHeight="500"
        MinWidth="330"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen">

    <!-- Главная сетка окна калькулятора -->
    <Grid Background="#FFF0F0F0" Margin="10">

        <Grid.RowDefinitions>
            <!-- Верхняя строка предназначена для экрана результата -->
            <RowDefinition Height="Auto"/>

            <!-- Остальное пространство занимают кнопки -->
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Экран калькулятора -->
        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#FFBDBDBD"
                BorderThickness="1"
                CornerRadius="5"
                Padding="10"
                Margin="0,0,0,10">

            <!-- Поле отображения введённого числа и результата -->
            <TextBox x:Name="txtDisplay"
                     Text="0"
                     FontSize="32"
                     Height="65"
                     IsReadOnly="True"
                     TextAlignment="Right"
                     VerticalContentAlignment="Center"
                     BorderThickness="0"
                     Background="White"
                     Padding="5"/>
        </Border>

        <!-- Сетка кнопок калькулятора -->
        <UniformGrid Grid.Row="1"
                     Rows="5"
                     Columns="4">

            <!-- Первая строка: очистка и деление -->
            <Button Content="C"
                    FontSize="20"
                    Margin="3"
                    Click="Clear_Click"/>

            <Button Content="⌫"
                    FontSize="20"
                    Margin="3"
                    Click="Backspace_Click"/>

            <Button Content="±"
                    FontSize="20"
                    Margin="3"
                    Click="Sign_Click"/>

            <Button Content="÷"
                    FontSize="20"
                    Margin="3"
                    Click="Operator_Click"/>

            <!-- Вторая строка: цифры 7, 8, 9 и умножение -->
            <Button Content="7"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="8"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="9"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="×"
                    FontSize="20"
                    Margin="3"
                    Click="Operator_Click"/>

            <!-- Третья строка: цифры 4, 5, 6 и вычитание -->
            <Button Content="4"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="5"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="6"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="−"
                    FontSize="20"
                    Margin="3"
                    Click="Operator_Click"/>

            <!-- Четвёртая строка: цифры 1, 2, 3 и сложение -->
            <Button Content="1"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="2"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="3"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content="+"
                    FontSize="20"
                    Margin="3"
                    Click="Operator_Click"/>

            <!-- Пятая строка: ноль, запятая и вычисление -->
            <Button Content="C"
                    FontSize="20"
                    Margin="3"
                    Click="Clear_Click"/>

            <Button Content="0"
                    FontSize="20"
                    Margin="3"
                    Click="Digit_Click"/>

            <Button Content=","
                    FontSize="20"
                    Margin="3"
                    Click="Decimal_Click"/>

            <Button Content="="
                    FontSize="20"
                    FontWeight="Bold"
                    Background="#FFB7D7F5"
                    Margin="3"
                    Click="Equals_Click"/>

        </UniformGrid>
    </Grid>
</Window>

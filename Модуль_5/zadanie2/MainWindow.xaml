<!-- Главное окно текстового редактора. -->
<Window x:Class="TextEditorWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Текстовый редактор"
        Height="600"
        Width="900"
        MinHeight="400"
        MinWidth="600"
        WindowStartupLocation="CenterScreen">

    <!-- Grid разделяет окно на меню, область текста и строку состояния. -->
    <Grid>
        <Grid.RowDefinitions>
            <!-- Первая строка содержит меню. -->
            <RowDefinition Height="Auto"/>

            <!-- Вторая строка занимает всё оставшееся место. -->
            <RowDefinition Height="*"/>

            <!-- Третья строка содержит информацию о документе. -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Главное меню программы. -->
        <Menu Grid.Row="0">

            <!-- Меню работы с файлами. -->
            <MenuItem Header="_Файл">

                <!-- Создание пустого документа. -->
                <MenuItem Header="_Создать"
                          Click="New_Click"/>

                <!-- Открытие существующего текстового файла. -->
                <MenuItem Header="_Открыть..."
                          Click="Open_Click"/>

                <!-- Сохранение документа в текущий файл. -->
                <MenuItem Header="_Сохранить"
                          Click="Save_Click"/>

                <!-- Сохранение документа под новым именем. -->
                <MenuItem Header="Сохранить _как..."
                          Click="SaveAs_Click"/>

                <!-- Разделитель визуально отделяет команды. -->
                <Separator/>

                <!-- Закрытие приложения. -->
                <MenuItem Header="_Выход"
                          Click="Exit_Click"/>

            </MenuItem>

        </Menu>


        <!-- Поле для ввода и редактирования текста. -->
        <TextBox x:Name="txtEditor"
                 Grid.Row="1"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 HorizontalScrollBarVisibility="Auto"
                 Padding="10"
                 FontSize="15"
                 BorderThickness="0"
                 TextChanged="txtEditor_TextChanged"/>

        <!-- Нижняя строка состояния. -->
        <StatusBar Grid.Row="2">

            <!-- Показываем имя открытого документа и его состояние. -->
            <TextBlock x:Name="txtStatus"
                       Text="Новый документ"/>

        </StatusBar>

    </Grid>
</Window>
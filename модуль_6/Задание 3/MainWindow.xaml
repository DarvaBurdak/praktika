<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Библиотека — каталог книг"
        Height="700" Width="1100"
        MinHeight="580" MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F9"
        FontFamily="Segoe UI">

    <Window.Resources>
        <Style x:Key="ActionButton" TargetType="Button">
            <Setter Property="Background" Value="#405CF5"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="Margin" Value="0,0,8,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>

        <Style x:Key="FieldBox" TargetType="TextBox">
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="0,4,10,10"/>
            <Setter Property="BorderBrush" Value="#D9DEEA"/>
            <Setter Property="Background" Value="White"/>
        </Style>
    </Window.Resources>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок программы -->
        <StackPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="Библиотека"
                       FontSize="28"
                       FontWeight="Bold"
                       Foreground="#202B46"/>
            <TextBlock Text="Каталог книг, поиск и управление арендой"
                       FontSize="13"
                       Foreground="#778198"
                       Margin="0,5,0,0"/>
        </StackPanel>

        <!-- Поиск по названию или автору -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="10"
                Padding="14"
                Margin="0,0,0,16">
            <DockPanel>
                <Button Content="Найти"
                        DockPanel.Dock="Right"
                        Style="{StaticResource ActionButton}"
                        Margin="8,0,0,0"
                        Click="Search_Click"/>
                <TextBox x:Name="txtSearch"
                         Padding="10"
                         FontSize="14"
                         BorderBrush="#D9DEEA"
                         VerticalContentAlignment="Center"
                         ToolTip="Введите название книги или автора"/>
            </DockPanel>
        </Border>

        <!-- Форма добавления книги -->
        <Border Grid.Row="2"
                Background="White"
                CornerRadius="10"
                Padding="16"
                Margin="0,0,0,16">
            <StackPanel>
                <TextBlock Text="Добавление книги"
                           FontSize="17"
                           FontWeight="SemiBold"
                           Foreground="#202B46"
                           Margin="0,0,0,12"/>

                <WrapPanel>
                    <StackPanel Width="190">
                        <TextBlock Text="Название"/>
                        <TextBox x:Name="txtTitle"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Width="170">
                        <TextBlock Text="Автор"/>
                        <TextBox x:Name="txtAuthor"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Width="100">
                        <TextBlock Text="Год издания"/>
                        <TextBox x:Name="txtYear"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Width="150">
                        <TextBlock Text="Жанр"/>
                        <TextBox x:Name="txtGenre"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>

                    <StackPanel Width="110">
                        <TextBlock Text="Экземпляры"/>
                        <TextBox x:Name="txtCopies"
                                 Text="1"
                                 Style="{StaticResource FieldBox}"/>
                    </StackPanel>
                </WrapPanel>

                <WrapPanel Margin="0,4,0,0">
                    <Button Content="Добавить книгу"
                            Style="{StaticResource ActionButton}"
                            Click="AddBook_Click"/>

                    <Button Content="Арендовать выбранную"
                            Style="{StaticResource ActionButton}"
                            Background="#159B72"
                            Click="Rent_Click"/>

                    <Button Content="Вернуть книгу"
                            Style="{StaticResource ActionButton}"
                            Background="#69758B"
                            Click="Return_Click"/>

                    <Button Content="Обновить список"
                            Style="{StaticResource ActionButton}"
                            Background="#69758B"
                            Click="Refresh_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <!-- Таблица каталога -->
        <Border Grid.Row="3"
                Background="White"
                CornerRadius="10"
                Padding="8">
            <DataGrid x:Name="BooksGrid"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      SelectionMode="Single"
                      SelectionUnit="FullRow"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      Background="White"
                      BorderThickness="0"
                      RowBackground="White"
                      AlternatingRowBackground="#F8F9FC">

                <DataGrid.Columns>
                    <DataGridTextColumn Header="№"
                                        Binding="{Binding Id}"
                                        Width="45"/>
                    <DataGridTextColumn Header="Название"
                                        Binding="{Binding Title}"
                                        Width="2*"/>
                    <DataGridTextColumn Header="Автор"
                                        Binding="{Binding Author}"
                                        Width="1.5*"/>
                    <DataGridTextColumn Header="Год"
                                        Binding="{Binding Year}"
                                        Width="65"/>
                    <DataGridTextColumn Header="Жанр"
                                        Binding="{Binding Genre}"
                                        Width="1*"/>
                    <DataGridTextColumn Header="Доступно"
                                        Binding="{Binding AvailableCopies}"
                                        Width="85"/>
                    <DataGridTextColumn Header="Всего"
                                        Binding="{Binding TotalCopies}"
                                        Width="70"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- Сообщения программы -->
        <TextBlock x:Name="txtMessage"
                   Grid.Row="4"
                   Text="Программа готова к работе."
                   Foreground="#69758B"
                   Margin="2,12,0,0"
                   TextWrapping="Wrap"/>
    </Grid>
</Window>

<Window x:Class="WpfApp1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Учёт сотрудников организации"
        Height="650"
        Width="1100"
        MinHeight="550"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F3F5F8">

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Заголовок приложения -->
        <TextBlock Grid.Row="0"
                   Text="Учёт сотрудников организации"
                   FontSize="26"
                   FontWeight="Bold"
                   Foreground="#23395B"
                   Margin="0,0,0,18"/>

        <!-- Поля для ввода и изменения данных -->
        <Border Grid.Row="1"
                Background="White"
                CornerRadius="8"
                Padding="15"
                Margin="0,0,0,15">

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фамилия -->
                <StackPanel Grid.Row="0" Grid.Column="0" Margin="5">
                    <TextBlock Text="Фамилия"/>
                    <TextBox x:Name="txtLastName"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Имя -->
                <StackPanel Grid.Row="0" Grid.Column="1" Margin="5">
                    <TextBlock Text="Имя"/>
                    <TextBox x:Name="txtFirstName"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Должность -->
                <StackPanel Grid.Row="0" Grid.Column="2" Margin="5">
                    <TextBlock Text="Должность"/>
                    <TextBox x:Name="txtPosition"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Отдел -->
                <StackPanel Grid.Row="1" Grid.Column="0" Margin="5">
                    <TextBlock Text="Отдел"/>
                    <TextBox x:Name="txtDepartment"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Телефон -->
                <StackPanel Grid.Row="1" Grid.Column="1" Margin="5">
                    <TextBlock Text="Телефон"/>
                    <TextBox x:Name="txtPhone"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Зарплата -->
                <StackPanel Grid.Row="1" Grid.Column="2" Margin="5">
                    <TextBlock Text="Зарплата"/>
                    <TextBox x:Name="txtSalary"
                             Margin="0,5,0,0"
                             Padding="7"/>
                </StackPanel>

                <!-- Кнопки управления записями -->
                <WrapPanel Grid.Row="2"
                           Grid.Column="0"
                           Grid.ColumnSpan="3"
                           Margin="5,12,5,0">

                    <Button Content="Добавить"
                            Click="Add_Click"
                            Padding="15,8"
                            Margin="0,0,8,5"
                            Background="#287D58"
                            Foreground="White"/>

                    <Button Content="Сохранить изменения"
                            Click="Update_Click"
                            Padding="15,8"
                            Margin="0,0,8,5"/>

                    <Button Content="Удалить"
                            Click="Delete_Click"
                            Padding="15,8"
                            Margin="0,0,8,5"
                            Background="#B94040"
                            Foreground="White"/>

                    <Button Content="Очистить поля"
                            Click="Clear_Click"
                            Padding="15,8"
                            Margin="0,0,8,5"/>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- Таблица сотрудников -->
        <DataGrid x:Name="EmployeesGrid"
                  Grid.Row="2"
                  AutoGenerateColumns="False"
                  IsReadOnly="True"
                  CanUserAddRows="False"
                  SelectionMode="Single"
                  SelectionUnit="FullRow"
                  SelectionChanged="EmployeesGrid_SelectionChanged"
                  Background="White"
                  BorderThickness="0"
                  RowHeight="32"
                  HeadersVisibility="Column">

            <DataGrid.Columns>
                <DataGridTextColumn Header="ID"
                                    Binding="{Binding Id}"
                                    Width="55"/>

                <DataGridTextColumn Header="Фамилия"
                                    Binding="{Binding LastName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Имя"
                                    Binding="{Binding FirstName}"
                                    Width="*"/>

                <DataGridTextColumn Header="Должность"
                                    Binding="{Binding Position}"
                                    Width="*"/>

                <DataGridTextColumn Header="Отдел"
                                    Binding="{Binding Department}"
                                    Width="*"/>

                <DataGridTextColumn Header="Телефон"
                                    Binding="{Binding Phone}"
                                    Width="*"/>

                <DataGridTextColumn Header="Зарплата"
                                    Binding="{Binding Salary,
                                        StringFormat={}{0:N2}}"
                                    Width="100"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- Строка состояния -->
        <TextBlock x:Name="txtStatus"
                   Grid.Row="3"
                   Margin="0,12,0,0"
                   Foreground="#526477"
                   Text="Готово к работе"/>
    </Grid>
</Window>

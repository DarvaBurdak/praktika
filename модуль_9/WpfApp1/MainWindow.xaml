<Window x:Class="ProjectTasksWPF.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Управление проектами и задачами"
        Height="760"
        Width="1180"
        MinHeight="600"
        MinWidth="850"
        WindowStartupLocation="CenterScreen"
        Background="#F5F3FA">

    <!-- Общая сетка главного окна. Она позволяет интерфейсу
         растягиваться вместе с окном, а не оставаться фиксированным. -->
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Заголовок программы. -->
        <StackPanel Grid.Row="0" Margin="0,0,0,14">
            <TextBlock Text="Управление проектами"
                       FontSize="26"
                       FontWeight="Bold"
                       Foreground="#45356A"/>

            <TextBlock Text="Проекты, сотрудники, задачи и отчёты"
                       FontSize="14"
                       Foreground="#766B8B"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Вкладки занимают всё оставшееся место окна. -->
        <TabControl Grid.Row="1"
                    FontSize="14"
                    Padding="8">

            <!-- ================================================= -->
            <!-- ВКЛАДКА ПРОЕКТОВ                                  -->
            <!-- ================================================= -->
            <TabItem Header="Проекты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Таблица проектов. -->
                    <DataGrid x:Name="ProjectsGrid"
                              SelectionChanged="ProjectsGrid_SelectionChanged"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding Id}"
                                                Width="55"/>
                            <DataGridTextColumn Header="Название"
                                                Binding="{Binding Name}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Начало"
                                                Binding="{Binding StartDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Завершение"
                                                Binding="{Binding EndDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Поля для ввода и редактирования проекта. -->
                    <Border Grid.Row="1"
                            Background="#EEE9F7"
                            CornerRadius="8"
                            Padding="12"
                            Margin="0,0,0,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                <TextBlock Text="Название проекта"/>
                                <TextBox x:Name="ProjectNameBox" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                <TextBlock Text="Дата начала"/>
                                <DatePicker x:Name="ProjectStartDate"
                                            SelectedDate="{x:Static sys:DateTime.Today}"
                                            xmlns:sys="clr-namespace:System;assembly=mscorlib"
                                            Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                                <TextBlock Text="Дата завершения"/>
                                <DatePicker x:Name="ProjectEndDate"
                                            Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="1"
                                        Grid.ColumnSpan="3"
                                        Margin="4">
                                <TextBlock Text="Описание проекта"/>
                                <TextBox x:Name="ProjectDescriptionBox"
                                         Margin="0,4,0,0"
                                         MinHeight="45"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"
                                         VerticalScrollBarVisibility="Auto"/>
                            </StackPanel>

                            <StackPanel Grid.Row="2"
                                        Grid.ColumnSpan="3"
                                        Margin="4">
                                <TextBlock Text="Статус проекта"/>
                                <ComboBox x:Name="ProjectStatusBox"
                                          Margin="0,4,0,0">
                                    <ComboBoxItem Content="Не начат"/>
                                    <ComboBoxItem Content="В работе"/>
                                    <ComboBoxItem Content="Приостановлен"/>
                                    <ComboBoxItem Content="Завершён"/>
                                </ComboBox>
                            </StackPanel>

                            <!-- Кнопки вызывают обработчики из MainWindow.xaml.cs. -->
                            <WrapPanel Grid.Row="3"
                                       Grid.ColumnSpan="3"
                                       Margin="4,10,4,0">
                                <Button Content="Добавить"
                                        Click="AddProject_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Изменить выбранный"
                                        Click="UpdateProject_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Удалить выбранный"
                                        Click="DeleteProject_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Очистить поля"
                                        Click="ClearProjectFields_Click"
                                        Padding="16,7"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <!-- Подсказка пользователю. -->
                    <TextBlock Grid.Row="2"
                               Text="Чтобы изменить проект, выберите его в таблице и нажмите «Изменить выбранный»."
                               TextWrapping="Wrap"
                               Foreground="#766B8B"
                               Margin="2"/>
                </Grid>
            </TabItem>

            <!-- ================================================= -->
            <!-- ВКЛАДКА СОТРУДНИКОВ                               -->
            <!-- ================================================= -->
            <TabItem Header="Сотрудники">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="EmployeesGrid"
                              SelectionChanged="EmployeesGrid_SelectionChanged"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding Id}"
                                                Width="55"/>
                            <DataGridTextColumn Header="ФИО"
                                                Binding="{Binding FullName}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Должность"
                                                Binding="{Binding Position}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Электронная почта"
                                                Binding="{Binding Email}"
                                                Width="2*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <Border Grid.Row="1"
                            Background="#EEE9F7"
                            CornerRadius="8"
                            Padding="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2*"/>
                            </Grid.ColumnDefinitions>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                <TextBlock Text="ФИО сотрудника"/>
                                <TextBox x:Name="EmployeeNameBox" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                <TextBlock Text="Должность"/>
                                <TextBox x:Name="EmployeePositionBox" Margin="0,4,0,0"/>
                            </StackPanel>

                            <StackPanel Grid.Row="0" Grid.Column="2" Margin="4">
                                <TextBlock Text="Электронная почта"/>
                                <TextBox x:Name="EmployeeEmailBox" Margin="0,4,0,0"/>
                            </StackPanel>

                            <WrapPanel Grid.Row="1"
                                       Grid.ColumnSpan="3"
                                       Margin="4,10,4,0">
                                <Button Content="Добавить"
                                        Click="AddEmployee_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Изменить выбранного"
                                        Click="UpdateEmployee_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Удалить выбранного"
                                        Click="DeleteEmployee_Click"
                                        Padding="16,7"
                                        Margin="0,0,8,0"/>
                                <Button Content="Очистить поля"
                                        Click="ClearEmployeeFields_Click"
                                        Padding="16,7"/>
                            </WrapPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="2"
                               Text="Сотрудников можно назначать на задачи во вкладке «Задачи»."
                               TextWrapping="Wrap"
                               Foreground="#766B8B"
                               Margin="2,10,2,0"/>
                </Grid>
            </TabItem>

            <!-- ================================================= -->
            <!-- ВКЛАДКА ЗАДАЧ                                     -->
            <!-- ================================================= -->
            <TabItem Header="Задачи">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DataGrid x:Name="TasksGrid"
          SelectionChanged="TasksGrid_SelectionChanged"
                              Grid.Row="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single"
                              SelectionUnit="FullRow"
                              CanUserAddRows="False"
                              Margin="0,0,0,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="№"
                                                Binding="{Binding Id}"
                                                Width="45"/>
                            <DataGridTextColumn Header="Задача"
                                                Binding="{Binding Title}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Проект"
                                                Binding="{Binding ProjectName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Исполнитель"
                                                Binding="{Binding EmployeeName}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Срок"
                                                Binding="{Binding DueDate, StringFormat={}{0:dd.MM.yyyy}}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Выполнено, %"
                                                Binding="{Binding Progress}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Статус"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Форма редактирования задачи находится под таблицей.
                         При уменьшении окна содержимое можно прокручивать. -->
                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  MaxHeight="310">
                        <Border Background="#EEE9F7"
                                CornerRadius="8"
                                Padding="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="4">
                                    <TextBlock Text="Название задачи"/>
                                    <TextBox x:Name="TaskTitleBox" Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="0" Grid.Column="1" Margin="4">
                                    <TextBlock Text="Проект"/>
                                    <ComboBox x:Name="TaskProjectBox"
                                              DisplayMemberPath="Name"
                                              SelectedValuePath="Id"
                                              Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="0" Margin="4">
                                    <TextBlock Text="Исполнитель"/>
                                    <ComboBox x:Name="TaskEmployeeBox"
                                              DisplayMemberPath="FullName"
                                              SelectedValuePath="Id"
                                              Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="1" Grid.Column="1" Margin="4">
                                    <TextBlock Text="Срок выполнения"/>
                                    <DatePicker x:Name="TaskDueDate"
                                                Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="2"
                                            Grid.ColumnSpan="2"
                                            Margin="4">
                                    <TextBlock Text="Описание задачи"/>
                                    <TextBox x:Name="TaskDescriptionBox"
                                             MinHeight="45"
                                             TextWrapping="Wrap"
                                             AcceptsReturn="True"
                                             VerticalScrollBarVisibility="Auto"
                                             Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="0" Margin="4">
                                    <TextBlock Text="Процент выполнения (0–100)"/>
                                    <TextBox x:Name="TaskProgressBox"
                                             Text="0"
                                             Margin="0,4,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Row="3" Grid.Column="1" Margin="4">
                                    <TextBlock Text="Статус задачи"/>
                                    <ComboBox x:Name="TaskStatusBox"
                                              Margin="0,4,0,0">
                                        <ComboBoxItem Content="Не начата"/>
                                        <ComboBoxItem Content="В работе"/>
                                        <ComboBoxItem Content="Завершена"/>
                                        <ComboBoxItem Content="Приостановлена"/>
                                    </ComboBox>
                                </StackPanel>

                                <WrapPanel Grid.Row="4"
                                           Grid.ColumnSpan="2"
                                           Margin="4,10,4,0">
                                    <Button Content="Добавить"
                                            Click="AddTask_Click"
                                            Padding="16,7"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Изменить выбранную"
                                            Click="UpdateTask_Click"
                                            Padding="16,7"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Удалить выбранную"
                                            Click="DeleteTask_Click"
                                            Padding="16,7"
                                            Margin="0,0,8,0"/>
                                    <Button Content="Очистить поля"
                                            Click="ClearTaskFields_Click"
                                            Padding="16,7"/>
                                </WrapPanel>
                            </Grid>
                        </Border>
                    </ScrollViewer>
                </Grid>
            </TabItem>

            <!-- ================================================= -->
            <!-- ВКЛАДКА ОТЧЁТОВ                                   -->
            <!-- ================================================= -->
            <TabItem Header="Отчёты">
                <Grid Margin="10">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0" Margin="0,0,0,10">
                        <TextBlock Text="Сводка по проектам"
                                   FontSize="20"
                                   FontWeight="SemiBold"
                                   Foreground="#45356A"/>

                        <TextBlock Text="Количество задач, завершённые задачи и средний процент выполнения."
                                   Margin="0,4,0,8"
                                   Foreground="#766B8B"
                                   TextWrapping="Wrap"/>

                        <Button Content="Обновить отчёт"
                                Click="RefreshReports_Click"
                                HorizontalAlignment="Left"
                                Padding="18,8"/>
                    </StackPanel>

                    <DataGrid x:Name="ReportsGrid"
                              Grid.Row="1"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              CanUserAddRows="False">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Проект"
                                                Binding="{Binding ProjectName}"
                                                Width="2*"/>
                            <DataGridTextColumn Header="Статус проекта"
                                                Binding="{Binding Status}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Всего задач"
                                                Binding="{Binding TotalTasks}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Завершено"
                                                Binding="{Binding CompletedTasks}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Осталось"
                                                Binding="{Binding RemainingTasks}"
                                                Width="*"/>
                            <DataGridTextColumn Header="Среднее выполнение, %"
                                                Binding="{Binding AverageProgress, StringFormat={}{0:F1}}"
                                                Width="*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</Window>
